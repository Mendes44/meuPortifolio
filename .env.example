# Public origin: exact origin, no trailing slash. Use the final URL in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# All Supabase values below are server-only. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_USER_ID=

# Generate a random secret of at least 32 bytes. Used only for temporary anti-abuse hashes.
RATE_LIMIT_SECRET=
# Leave blank unless your host guarantees this header is overwritten with the real client IP.
# Vercel example: x-vercel-forwarded-for. Never trust a browser-provided header.
TRUSTED_CLIENT_IP_HEADER=

# Contact delivery: Resend API key and a sender from your verified domain.
RESEND_API_KEY=
CONTACT_FROM=
